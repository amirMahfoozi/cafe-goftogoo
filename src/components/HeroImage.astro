---
import type { CafeInfo } from "@/types/menu";
import { assetPath } from "@/utils/assetPath";

interface Props {
  cafe: CafeInfo;
}

const { cafe } = Astro.props;
---

<div class="hero-image">
  <picture>
    <source
      type="image/avif"
      srcset={`${assetPath("/images/cafe/interior-hero-640.avif")} 640w, ${assetPath("/images/cafe/interior-hero-960.avif")} 960w, ${assetPath("/images/cafe/interior-hero-1280.avif")} 1280w`}
      sizes="(min-width: 1376px) 1216px, (min-width: 720px) calc(100vw - 128px), calc(100vw - 28px)"
    />
    <source
      type="image/webp"
      srcset={`${assetPath("/images/cafe/interior-hero-640.webp")} 640w, ${assetPath("/images/cafe/interior-hero-960.webp")} 960w, ${assetPath("/images/cafe/interior-hero-1280.webp")} 1280w`}
      sizes="(min-width: 1376px) 1216px, (min-width: 720px) calc(100vw - 128px), calc(100vw - 28px)"
    />
    <img
      src={assetPath(cafe.heroImage)}
      alt={cafe.heroImageAlt}
      width="1280"
      height="560"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
</div>

<style>
  .hero-image {
    margin-inline: var(--page-padding);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-soft);
    box-shadow: var(--shadow-sm);
  }

  picture,
  img {
    display: block;
    inline-size: 100%;
  }

  img {
    aspect-ratio: 16 / 7;
    block-size: auto;
    object-fit: cover;
    object-position: center 58%;
  }

  @media (min-width: 720px) {
    .hero-image {
      border-radius: var(--radius-xl);
    }

    img {
      aspect-ratio: 16 / 5.6;
      max-block-size: 440px;
    }
  }
</style>
