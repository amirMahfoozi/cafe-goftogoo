---
import type { MenuCategory, MenuItem } from "@/types/menu";
import CategoryIcon from "./CategoryIcon.astro";
import MenuCard from "./MenuCard.astro";

interface Props {
  category: MenuCategory;
  items: readonly MenuItem[];
}

const { category, items } = Astro.props;
---

<section
  class="menu-section"
  id={`category-${category.id}`}
  data-menu-section={category.id}
  aria-labelledby={`category-title-${category.id}`}
>
  <header class="menu-section__header">
    <span class="menu-section__icon"
      ><CategoryIcon icon={category.icon} size={34} /></span
    >
    <div>
      <h2 id={`category-title-${category.id}`}>{category.title}</h2>
      <p>{items.length.toLocaleString("fa-IR")} انتخاب</p>
    </div>
  </header>
  <div class="menu-section__grid">
    {items.map((item) => <MenuCard item={item} />)}
  </div>
</section>

<style>
  .menu-section {
    scroll-margin-block-start: var(--section-scroll-margin);
  }

  .menu-section__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
  }

  .menu-section__header::after {
    content: "";
    min-inline-size: 2rem;
    block-size: 1px;
    flex: 1;
    margin-inline-start: var(--space-2);
    background: var(--color-border);
    opacity: 0.72;
  }

  .menu-section__icon {
    display: grid;
    inline-size: 54px;
    block-size: 54px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-secondary) 68%, var(--color-border));
    border-radius: 1rem;
    color: var(--color-text);
    background: var(--color-surface-soft);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 780;
    line-height: 1.45;
  }

  .menu-section__header p {
    margin: 0.05rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .menu-section__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 349px) {
    .menu-section__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 720px) {
    .menu-section__header {
      margin-block-end: var(--space-5);
    }

    .menu-section__icon {
      inline-size: 62px;
      block-size: 62px;
    }

    h2 {
      font-size: 1.75rem;
    }

    .menu-section__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.4rem);
    }
  }

  @media (min-width: 1080px) {
    .menu-section__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
