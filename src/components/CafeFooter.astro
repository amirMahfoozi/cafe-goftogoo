---
import type { CafeInfo } from "@/types/menu";
import { assetPath } from "@/utils/assetPath";
import ActionButton from "./ActionButton.astro";

interface Props {
  cafe: CafeInfo;
}

const { cafe } = Astro.props;
const phoneHref = cafe.phone
  ? `tel:${cafe.phone.replace(/\s+/g, "")}`
  : undefined;
---

<footer class="cafe-footer" id="contact-details">
  <div class="cafe-footer__ambience">
    <picture>
      <source
        type="image/avif"
        srcset={`${assetPath("/images/cafe/interior-counter-640.avif")} 640w, ${assetPath("/images/cafe/interior-counter-960.avif")} 960w`}
        sizes="(min-width: 1376px) 1216px, (min-width: 720px) calc(100vw - 128px), calc(100vw - 28px)"
      />
      <img
        src={assetPath("/images/cafe/interior-counter-960.webp")}
        alt="میزهای چوبی و پیشخوان کافه گفتگو در نور طبیعی"
        width="960"
        height="540"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="cafe-footer__ambience-copy">
      <p>گفت‌وگو از همین‌جا شروع می‌شود.</p>
    </div>
  </div>

  <div class="cafe-footer__notes">
    <p>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="8"></circle>
        <path d="M10 6v4M10 14h.01"></path>
      </svg>
      <span>تمام قیمت‌ها به هزار تومان است.</span>
    </p>
    <p>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M10 3c4 0 7 3 7 7s-3 7-7 7-7-3-7-7 3-7 7-7Z"></path>
        <path d="M7 7c2 1 4 4 4 7M13 6c-3 2-5 5-5 8"></path>
      </svg>
      <span>لطفاً حساسیت غذایی خود را به پرسنل کافه اطلاع دهید.</span>
    </p>
    <p>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M4 6h12v9H4z"></path>
        <path d="M7 9h6M7 12h4"></path>
      </svg>
      <span>قیمت موارد دارای برچسب «استعلام قیمت» از منوی کافه تأیید شود.</span>
    </p>
  </div>

  <address class="cafe-footer__address">
    <span>نشانی</span>
    <p>{cafe.address || "نشانی رسمی کافه هنوز ثبت نشده است."}</p>
  </address>

  <div class="cafe-footer__actions" aria-label="راه‌های ارتباط با کافه">
    <ActionButton
      label="تماس"
      accessibleLabel="تماس با کافه گفتگو"
      href={phoneHref}
      icon="phone"
    />
    <ActionButton
      label="اینستاگرام"
      accessibleLabel="مشاهده اینستاگرام کافه گفتگو"
      href={cafe.instagramUrl || undefined}
      icon="instagram"
    />
    <ActionButton
      label="مسیریابی"
      accessibleLabel="مسیریابی به کافه گفتگو"
      href={cafe.mapUrl || undefined}
      icon="map"
    />
  </div>

  <p class="cafe-footer__credit">
    منوی دیجیتال {cafe.name}
    <span aria-hidden="true"> · </span>
    <a href="https://openmoji.org/" rel="license external"
      >آیکون‌ها: OpenMoji (CC BY-SA 4.0)</a
    >
  </p>
</footer>

<style>
  .cafe-footer {
    padding: var(--space-5) var(--page-padding)
      calc(var(--space-5) + env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--color-border);
    background: color-mix(
      in srgb,
      var(--color-surface-soft) 48%,
      var(--color-background)
    );
  }

  .cafe-footer__ambience {
    position: relative;
    overflow: hidden;
    margin-block-end: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-soft);
  }

  .cafe-footer__ambience picture,
  .cafe-footer__ambience img {
    display: block;
    inline-size: 100%;
  }

  .cafe-footer__ambience img {
    aspect-ratio: 16 / 8;
    block-size: auto;
    object-fit: cover;
    object-position: center 56%;
  }

  .cafe-footer__ambience-copy {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem var(--space-4) var(--space-3);
    color: var(--color-background);
    background: linear-gradient(to top, rgb(43 33 24 / 0.8), transparent);
  }

  .cafe-footer__ambience-copy p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .cafe-footer__notes {
    display: grid;
    gap: var(--space-3);
  }

  .cafe-footer__notes p {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.79rem;
    line-height: 1.8;
  }

  .cafe-footer__notes svg {
    flex: 0 0 auto;
    margin-block-start: 0.18rem;
    fill: none;
    stroke: var(--color-primary-strong);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .cafe-footer__address {
    margin-block: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-style: normal;
  }

  .cafe-footer__address span {
    color: var(--color-primary-strong);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .cafe-footer__address p {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.75;
  }

  .cafe-footer__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .cafe-footer__credit {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    text-align: center;
  }

  .cafe-footer__credit a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 720px) {
    .cafe-footer {
      padding-block-start: var(--space-7);
    }

    .cafe-footer__ambience img {
      aspect-ratio: 16 / 5.5;
      max-block-size: 430px;
    }

    .cafe-footer__notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .cafe-footer__notes p {
      padding: var(--space-3);
      border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
      border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--color-background) 70%, transparent);
    }

    .cafe-footer__actions {
      max-inline-size: 760px;
      gap: var(--space-3);
      margin-inline: auto;
    }
  }
</style>
